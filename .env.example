# Podkład mapy: kafle wektorowe w schemacie OpenMapTiles (TileJSON albo szablon .../{z}/{x}/{y}.pbf).
# Bez niego mapa działa, ale bez podkładu (tylko odcinki na tle koloru lądu) i pokazuje o tym komunikat.
# Nie wpisuj kluczy API do repozytorium. W GitHub Actions ustaw jako Repository variable (Settings > Variables).
VITE_TILES_URL=
# Opcjonalnie: glify dla podpisów, np. https://example.org/fonts/{fontstack}/{range}.pbf. Bez nich mapa nie ma podpisów.
VITE_GLYPHS_URL=
# Nazwa kroju w glifach (domyślnie "Noto Sans Regular").
VITE_GLYPHS_FONT=
